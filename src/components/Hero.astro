---
import { IDENTITY } from "../data/portfolio.js";

const initials = IDENTITY.name
  .split(/\s+/)
  .map((word) => word[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();

const words = IDENTITY.tagline;

const socials = [
  {
    kind: "github",
    href: IDENTITY.github,
    path:
      '<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>',
  },
  {
    kind: "linkedin",
    href: IDENTITY.linkedin,
    path:
      '<path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146Zm4.943 12.248V6.169H2.542v7.225h2.401Zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016Zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4Z"/>',
  },
  {
    kind: "email",
    href: "mailto:" + IDENTITY.email,
    path:
      '<path fill="currentColor" d="M1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25v-8.5C0 2.784.784 2 1.75 2ZM1.5 12.251c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25V5.809L8.38 9.397a.75.75 0 0 1-.76 0L1.5 5.809v6.442Zm13-8.181v-.32a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25v.32L8 7.88l6.5-3.81Z"/>',
  },
];
---

<section id="home" class="section hero-section">
  <div class="container hero-panel">
    <div class="hero-card">
      <div class="hero-left">
        <img class="avatar avatar-lg" id="heroAvatar" src={IDENTITY.photo} alt={`${IDENTITY.name} profile photo`} />
        <div class="hero-socials">
          {
            socials.map((social) => (
              <a
                class="social-icon"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.kind}
              >
                <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" set:html={social.path}></svg>
              </a>
            ))
          }
        </div>
      </div>
      <div class="hero-right">
        <p class="hero-greet" id="heroGreet"></p>
        <h1 class="hero-name">{IDENTITY.name}</h1>
        <p class="hero-tagline" id="heroTagline"></p>
        <p class="hero-location">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path fill="currentColor" d="m12.596 11.596-3.535 3.536a1.5 1.5 0 0 1-2.122 0l-3.535-3.536a6.5 6.5 0 1 1 9.192-9.193 6.5 6.5 0 0 1 0 9.193Zm-1.06-8.132v1.5a4 4 0 0 0-5.95 5.212v-.78a4 4 0 0 1 5.95-5.93Zm0 0v4.536a4 4 0 0 1-6.022 3.533l-.1-.058 1.06-1.06a2.5 2.5 0 0 0 4.06-1.454h-2.49v-2.5h2.49c.015-.335 0-.68-.05-1.012l.952-.985Z" />
          </svg>
          {IDENTITY.location}
        </p>
        <p class="hero-phone">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path fill="currentColor" d="M1.75 1.782c.696 0 1.389.105 2.058.318.571.18.868 1.046.845 1.666-.069 1.871-.739 2.28-.55 3.688.188 1.409 1.3 2.52 2.71 2.71 1.406.188 1.815-.482 3.687-.55.62-.024 1.485.274 1.666.845.213.669.317 1.362.317 2.058 0 .5-.253.965-.622 1.247-.28.21-1.66 1.15-2.636.885-2.866-.775-4.785-1.038-6.645-2.898-1.86-1.861-2.124-3.78-2.898-6.646-.265-.977.674-2.355.885-2.635.282-.369.747-.622 1.246-.622ZM8 0a8 8 0 1 1 .699 15.966l-4.49 1.348a1 1 0 0 1-1.235-1.002l.059-4.702a8 8 0 0 1 4.967-11.61Z" />
          </svg>
          {IDENTITY.phone}
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={IDENTITY.resume} download>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path fill="currentColor" d="M7.47 10.78a.75.75 0 0 0 1.06 0l3.75-3.75a.75.75 0 0 0-1.06-1.06L8.75 8.44V1.75a.75.75 0 0 0-1.5 0v6.69L4.78 5.97a.75.75 0 0 0-1.06 1.06l3.75 3.75ZM3.75 13.25a.75.75 0 0 0 0 1.5h8.5a.75.75 0 0 0 0-1.5h-8.5Z" />
            </svg>
            Download CV
          </a>
          <a class="btn btn-ghost" href="#projects">View Projects</a>
        </div>
        <div class="live-bar">
          <span class="live-dot"></span>
          <span class="live-status">Open to opportunities</span>
          <span class="live-sep" aria-hidden="true">·</span>
          <span class="live-now" id="heroClock"></span>
          <span class="live-sep" aria-hidden="true">·</span>
          <span class="live-now" id="todayLine"></span>
          <span class="live-sep" aria-hidden="true">·</span>
          <span class="live-now" id="phaseLabel"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ words }}>
  const TZ = "Asia/Kolkata";

  const avatar = document.getElementById("heroAvatar");
  avatar.addEventListener("error", () => {
    avatar.classList.add("avatar-fallback");
    avatar.removeAttribute("src");
    avatar.textContent = "SR";
  });

  const el = document.getElementById("heroTagline");
  let wordIndex = 0;
  let charIndex = 0;
  let deleting = false;
  const type = () => {
    const word = words[wordIndex];
    charIndex = deleting ? charIndex - 1 : charIndex + 1;
    el.textContent = word.slice(0, charIndex);
    el.append(Object.assign(document.createElement("span"), { className: "caret", textContent: "\u00A0" }));
    if (!deleting && charIndex === word.length) {
      deleting = true;
      setTimeout(type, 1400);
      return;
    }
    if (deleting && charIndex === 0) {
      deleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      setTimeout(type, 300);
      return;
    }
    setTimeout(type, deleting ? 45 : 85);
  };
  type();

  const hourIn = (now) =>
    Number(now.toLocaleTimeString("en-GB", { timeZone: TZ, hour: "numeric", hour12: false }));

  const greetingFor = (hour) => {
    if (hour < 5) return "Good night";
    if (hour < 12) return "Good morning";
    if (hour < 17) return "Good afternoon";
    if (hour < 21) return "Good evening";
    return "Good night";
  };

  const phaseFor = (hour) => {
    if (hour < 5) return "Rested — I will be online in the morning";
    if (hour < 8) return "Early session — planning the day ahead";
    if (hour < 13) return "Deep work — coding and testing";
    if (hour < 15) return "Short midday break";
    if (hour < 19) return "Afternoon build — web dev and upskilling";
    return "Evening — learning and side projects";
  };

  const live = {
    greet: document.getElementById("heroGreet"),
    clock: document.getElementById("heroClock"),
    today: document.getElementById("todayLine"),
    phase: document.getElementById("phaseLabel"),
  };

  const format = {
    clock: new Intl.DateTimeFormat("en-US", {
      timeZone: TZ,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }),
    today: new Intl.DateTimeFormat("en-US", {
      timeZone: TZ,
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    }),
  };

  const tick = () => {
    const now = new Date();
    const hour = hourIn(now);
    if (live.greet) live.greet.textContent = `${greetingFor(hour)}, Chennai`;
    if (live.today) live.today.textContent = format.today.format(now);
    if (live.clock) live.clock.textContent = `${format.clock.format(now)} IST`;
    if (live.phase) live.phase.textContent = phaseFor(hour);
  };
  tick();
  setInterval(tick, 1000);
</script>