---
import { PROJECTS } from "../data/portfolio.js";

const categories = ["All", ...new Set(PROJECTS.map((project) => project.category))];
const escapeHtml = (value) =>
  String(value).replace(/[&<>"']/g, (c) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  }[c]));
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="filter-bar" id="filterBar" role="group" aria-label="Filter projects">
      {
        categories.map(
          (category) => (
            <button
              class:list={["filter-chip", category === "All" && "active-chip"]}
              data-category={category}
            >
              {category}
            </button>
          )
        )
      }
    </div>
    <div class="projects-grid" id="projectsGrid"></div>
  </div>
</section>

<script define:vars={{ projects: PROJECTS }}>
  const grid = document.getElementById("projectsGrid");
  const bar = document.getElementById("filterBar");

  const links = (project) => {
    const githubPath = '<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>';
    const livePath = '<path fill="currentColor" d="M7.177 3.073 9.573.677A.25.25 0 0 1 9.927 0V0c.042 0 .084.006.119.023a.25.25 0 0 1 .134.143l3.794 9.244a.25.25 0 0 1-.338.325l-2.4-1.216a.25.25 0 0 0-.363.157l-1.098 3.356a.25.25 0 0 1-.328.159.25.25 0 0 1-.134-.143L6.97 9.474a.25.25 0 0 0-.157-.275l-2.292-.966a.25.25 0 0 1-.157-.276.25.25 0 0 1 .263-.164l2.327.424a.25.25 0 0 0 .275-.211l.026-.085-.006-.01a.25.25 0 0 1 .057-.318ZM16 2.5a.5.5 0 0 1-.5.5.5.5 0 0 1-.5-.5.5.5 0 0 1 .5-.5.5.5 0 0 1 .5.5ZM15.5 1.75a.25.25 0 0 1 .25.25v2a.25.25 0 0 1-.25.25h-2a.25.25 0 0 1-.25-.25v-2a.25.25 0 0 1 .25-.25h2ZM7 6.25a.75.75 0 1 0 0 1.5h2.5a.75.75 0 1 0 0-1.5H7Z"/>';
    let markup = "";
    if (project.github) {
      markup += `<a class="linker" href="${project.github}" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">${githubPath}</svg></a>`;
    }
    if (project.live) {
      markup += `<a class="linker" href="${project.live}" target="_blank" rel="noopener noreferrer" aria-label="Live demo"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">${livePath}</svg></a>`;
    }
    return markup;
  };

  const card = (project) =>
    `<article class="project-card visible">
      <div class="project-head">
        <span class="project-category">${project.category}</span>
        <div class="project-links">${links(project)}</div>
      </div>
      <h3 class="project-title">${project.title}</h3>
      <p class="project-desc">${project.description}</p>
      <div class="project-tech">${project.tech.map((tech) => `<span class="tech-pill">${tech}</span>`).join("")}</div>
      <div class="project-meta"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8Zm.75 1.53a6.53 6.53 0 0 1 5.81 5.72H11.5a.75.75 0 0 1-3 .75V3.1c0-.53.14-1.03.5-1.03.13 0 .17.09.25.3Zm-8.5 9.22a6.55 6.55 0 0 1-.25-3.25h.25v2.75a.5.5 0 0 0 .34.47l2.5.73a.5.5 0 0 0 .41-.11l1.63-1.35a.5.5 0 0 0 .11-.42l-.34-2.19a.5.5 0 0 0-.4-.42L2.1 6.49a.5.5 0 0 0-.6.5v3.76l-.25-.01Zm7.75.5h1.5a.75.75 0 0 1 0 1.5H7.99v-1.5Zm-1.5.72a.75.75 0 0 1 0 1.5H4.3a.75.75 0 0 1 0-1.5h4.6Zm8.25-3.72a6.53 6.53 0 0 1-.5 1.75l-.5-.13a.75.75 0 0 1-.42-1.15.75.75 0 0 1 .59-.36l.92-.11c.09.18.16.37.2.56l-.29.63Z"/></svg> ${project.year}</div>
    </article>`;

  const render = (filter) => {
    const active = filter || "All";
    const list = active === "All" ? projects : projects.filter((project) => project.category === active);
    grid.innerHTML = list.map(card).join("");
  };

  bar.addEventListener("click", (event) => {
    const chip = event.target.closest(".filter-chip");
    if (!chip) return;
    bar.querySelectorAll(".filter-chip").forEach((item) => item.classList.remove("active-chip"));
    chip.classList.add("active-chip");
    render(chip.dataset.category);
  });

  render("All");
</script>